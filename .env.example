# Optional: an OpenAI-compatible LLM. Leave LLM_API_KEY empty to run fully offline with the rule engine.
# Free keys: https://openrouter.ai/keys  (pick any model ending in ":free")
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Uploaded files and their analysis are deleted after this many minutes.
RETENTION_MINUTES=60
MAX_UPLOAD_MB=15

# Windows only, if Tesseract is installed but not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Use real sentence embeddings for clause matching (needs: pip install sentence-transformers)
USE_EMBEDDINGS=0
